# Cache plan (see docs/cost-and-traffic.md):
#  - /assets/* is fingerprinted, so it is immutable.
#  - Model parts and a release's config/tokenizer live at versioned paths (<id>/<version>), so they
#    are immutable too: a new model is a new path, never an overwrite.
#  - /release/manifest.json is the one file that changes under a fixed URL (which release each
#    language runs). `no-cache` makes every load revalidate it (ETag, a 304 costs nothing). It
#    has its own name because an earlier immutable `web-release.json` still sits in some browsers.
#  - HTML keeps the static-assets default `public, max-age=0, must-revalidate`, so a new deploy is
#    picked up on the next load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/release/manifest.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex
/release/:model/:version/config.json
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex
/release/:model/:version/tokenizer.json
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex
/models/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

# The developer playground is a tool, not a page to rank (SPA fallback; the app also adds a meta).
/lab
  X-Robots-Tag: noindex
/lab/*
  X-Robots-Tag: noindex

# Static SEO pages and crawl files: short cache so edits show up within the hour.
/gioi-thieu
  Cache-Control: public, max-age=3600
/about
  Cache-Control: public, max-age=3600
/gioi-thieu.html
  Cache-Control: public, max-age=3600
/about.html
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
