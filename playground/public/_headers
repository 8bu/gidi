# Hashed build output, the versioned release files and the model parts never change in place (a
# new release is a new path). The model parts are the 16 MiB pieces scripts/sync-release.mjs cuts
# from model.int8.onnx; the browser joins them and checks the sha256 of the whole file.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/release/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex
/models/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

# The developer playground is a tool, not a page to rank (SPA fallback; the app also adds a meta).
/lab
  X-Robots-Tag: noindex
/lab/*
  X-Robots-Tag: noindex

# Static SEO pages and crawl files: short cache so edits show up within the hour.
/gioi-thieu
  Cache-Control: public, max-age=3600
/about
  Cache-Control: public, max-age=3600
/gioi-thieu.html
  Cache-Control: public, max-age=3600
/about.html
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
