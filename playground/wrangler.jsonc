{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets only, on purpose: no `main`, so no Worker code ever runs. Requests to static assets are
  // free and unlimited (https://developers.cloudflare.com/workers/platform/pricing/), and the
  // 29 MB models are static assets too (cut into parts by scripts/sync-release.mjs), so no request
  // can add to the Workers, R2 or Logs bill. See docs/cost-and-traffic.md before adding a Worker.
  "name": "gidi",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "gidi.8bu.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
