{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gidi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The model route and the home page (to inject the language hint) need the Worker;
    // everything else is served straight from assets.
    "run_worker_first": ["/models/*", "/"]
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "gidi-models"
    }
  ],
  "routes": [{ "pattern": "gidi.8bu.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
